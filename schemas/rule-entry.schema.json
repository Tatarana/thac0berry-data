{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thac0berry/schemas/rule-entry.schema.json",
  "title": "Regras (PHB/DMG)",
  "description": "Espelha o decode em Swift: Models/Rule.swift.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/RuleEntry"
  },
  "$defs": {
    "RuleEntry": {
      "type": "object",
      "required": [
        "id",
        "book",
        "chapterNumber",
        "chapterTitle",
        "breadcrumbs",
        "topic",
        "ruleType",
        "summary",
        "content",
        "tables",
        "relatedRuleIds",
        "relatedSpells",
        "relatedMagicItems",
        "searchKeywords"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "book": {
          "type": "string"
        },
        "chapterNumber": {
          "type": "integer"
        },
        "chapterTitle": {
          "type": "string"
        },
        "breadcrumbs": {
          "type": "string"
        },
        "topic": {
          "type": "string"
        },
        "ruleType": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RuleTable"
          }
        },
        "relatedRuleIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relatedSpells": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relatedMagicItems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "searchKeywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "RuleTable": {
      "type": "object",
      "required": [
        "tableNumber",
        "title",
        "headers",
        "rows"
      ],
      "properties": {
        "tableNumber": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "headers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
