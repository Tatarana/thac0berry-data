{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thac0berry/schemas/weapon.schema.json",
  "title": "Armas",
  "description": "Espelha o decode em Swift: Models/Weapon.swift.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/Weapon"
  },
  "$defs": {
    "Weapon": {
      "type": "object",
      "required": [
        "id",
        "name",
        "speedFactor",
        "attacksPerRound"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "speedFactor": {
          "type": "integer"
        },
        "attacksPerRound": {
          "type": "string"
        },
        "size": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "damageSmall": {
          "type": [
            "string",
            "null"
          ]
        },
        "damageLarge": {
          "type": [
            "string",
            "null"
          ]
        },
        "range": {
          "anyOf": [
            {
              "$ref": "#/$defs/WeaponRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "cost": {
          "type": [
            "string",
            "null"
          ],
          "description": "Preço do PHB (Table 44), texto do livro: \"15 gp\"; \"—\" quando o livro não cobra nada."
        },
        "weight": {
          "type": [
            "string",
            "null"
          ],
          "description": "Peso do PHB (Table 44): \"4 lbs.\"."
        },
        "ammunition": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ammunition"
            },
            {
              "type": "null"
            }
          ],
          "description": "Armas de disparo: a munição vendida à parte (PHB Table 44)."
        }
      }
    },
    "WeaponRange": {
      "type": "object",
      "required": [],
      "properties": {
        "short": {
          "type": [
            "string",
            "null"
          ]
        },
        "medium": {
          "type": [
            "string",
            "null"
          ]
        },
        "long": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Ammunition": {
      "type": "object",
      "required": [
        "name",
        "cost",
        "quantity"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "cost": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "description": "Quantas vêm pelo preço (12 flechas por 3 sp)."
        },
        "weight": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
